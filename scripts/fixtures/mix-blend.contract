// CSS `mix-blend-mode` on boxes: a yellow box multiplied with the blue and
// white bars of its parent, and one multiplied with an earlier sibling, the
// blue box it overlaps. Multiplied, yellow over blue is #2a6600 and over
// white stays yellow.
component MixBlend
  view
    main testId="mix-blend" position="relative" width=390 height=300 background-color="#ffffff"
      box testId="bars" position="absolute" left=20 top=20 width=350 height=120 background-image="repeating-linear-gradient(90deg, #2a7ae2 0 20px, #ffffff 20px 40px)"
        box testId="over-parent" position="absolute" left=40 top=20 width=270 height=80 background-color="#ffd600" mix-blend-mode="multiply"
      box testId="under" position="absolute" left=20 top=170 width=160 height=100 background-color="#2a7ae2"
      box testId="over-sibling" position="absolute" left=100 top=190 width=160 height=60 background-color="#ffd600" mix-blend-mode="multiply"
