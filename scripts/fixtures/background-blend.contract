// CSS `background-blend-mode`'s parity page: a 45° hatch of #cccccc and
// white stripes over #2a7ae2, multiplied (darker stripes of the same hue)
// and unblended; the same hatch multiplied over a transparent colour inside
// a red box, which it leaves red-free, since the layers blend only with the
// box's own background; two layers screened over the colour; and one
// plain linear gradient multiplied over the colour.
component BackgroundBlend
  view
    main testId="background-blend" position="relative" width=390 height=460 background-color="#ffffff"
      box testId="multiply" position="absolute" left=20 top=20 width=160 height=120 background-color="#2a7ae2" background-image="repeating-linear-gradient(45deg, #cccccc 0 10px, #ffffff 10px 20px)" background-blend-mode="multiply"
      box testId="normal" position="absolute" left=210 top=20 width=160 height=120 background-color="#2a7ae2" background-image="repeating-linear-gradient(45deg, #cccccc 0 10px, #ffffff 10px 20px)"
      box testId="behind" position="absolute" left=20 top=170 width=160 height=120 padding=20 box-sizing="border-box" background-color="#e53935"
        box testId="clear" width=120 height=80 background-image="repeating-linear-gradient(45deg, #cccccc 0 10px, #ffffff 10px 20px)" background-blend-mode="multiply"
      box testId="screen" position="absolute" left=210 top=170 width=160 height=120 border-radius=24 background-color="#2a7ae2" background-image="linear-gradient(to right, #00000000, #ff000080), repeating-linear-gradient(0deg, #000000 0 10px, #808080 10px 20px)" background-blend-mode="screen"
      box testId="linear" position="absolute" left=20 top=320 width=160 height=120 background-color="#2a7ae2" background-image="linear-gradient(to right, #ffffff, #000000)" background-blend-mode="multiply"
