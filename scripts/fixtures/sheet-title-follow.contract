// A sheet route that writes no `color-scheme`, so it follows the session's
// appearance, under a transparent bar whose title is a heading with a light
// and a dark ink (NavigationTitleSchemeIOSTests).
routes nav
  home "/"
    sheet "/sheet"

component App
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` position="absolute" inset=0 padding=16
            link href="/sheet" testId="open"
              text "Open"
        if e.name == "sheet"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationDetent="fit-content" navigationBar="transparent" position="absolute" inset=0 background-color="light-dark(#ffffff, #000000)" testId="route-sheet"
            header display="flex" align-items="center" padding="8px 16px"
              text "Sheet" role="heading" color="light-dark(#000000, #ffffff)" testId="sheet-title"
              button id="back" press=back aria-label="Close" testId="close"
                image "symbol:close"
            column padding=16 min-height=200
              text "Body" color="light-dark(#000000, #ffffff)"
