keyframes fade
  from opacity=0
  to opacity=1

component Timelines
  view
    column testId="root" width=400
      view testId="drag" width=10 height=10 flex-shrink=0 -exact-drag-timeline="--drag y"
      column timeline-scope="--st" flex-shrink=0
        row testId="st" width=200 height=40 flex-shrink=0 overflow-x="auto" overflow-y="hidden" scroll-timeline="--st x"
          for i in range(10) key=i
            view width=80 height=40 flex-shrink=0
        view testId="st-normal" width=10 height=4 flex-shrink=0 opacity=0.25 animation="fade 1s linear both" animation-timeline="--st"
        view testId="st-px" width=10 height=4 flex-shrink=0 opacity=0.25 animation="fade 1s linear both" animation-timeline="--st" animation-range="100px 400px"
        view testId="st-pct" width=10 height=4 flex-shrink=0 opacity=0.25 animation="fade 1s linear both" animation-timeline="--st" animation-range="25% 75%"
        view testId="st-start" width=10 height=4 flex-shrink=0 opacity=0.25 animation="fade 1s linear both" animation-timeline="--st" animation-range="50%"
        view testId="st-named" width=10 height=4 flex-shrink=0 opacity=0.25 animation="fade 1s linear both" animation-timeline="--st" animation-range="contain 20% contain 80%"
        view testId="st-delay" width=10 height=4 flex-shrink=0 opacity=0.25 animation="fade 1s linear 1s both" animation-timeline="--st"
        view testId="st-fill" width=10 height=4 flex-shrink=0 opacity=0.25 animation="fade 1s linear" animation-timeline="--st" animation-range="100px 400px"
      column testId="sv" width=100 height=100 flex-shrink=0 overflow-y="auto" padding=10 border-width=5 border-style="solid" border-color="#000000" scroll-timeline-name="--sv"
        view testId="sv-anon" height=10 flex-shrink=0 opacity=0.25 animation="fade 1s linear both" animation-timeline="scroll()"
        view testId="sv-named" height=10 flex-shrink=0 opacity=0.25 animation="fade 1s linear both" animation-timeline="--sv"
        view testId="sv-self" height=10 flex-shrink=0 overflow="hidden" opacity=0.25 animation="fade 1s linear both" animation-timeline="scroll(self)"
        view height=300 flex-shrink=0
